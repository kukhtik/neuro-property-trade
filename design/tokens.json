{
  "schema": "npt-skin-tokens/2",
  "version": "2026-10-12",
  "note": [
    "The design system expressed as skin tokens. 'shared' holds values identical for every skin;",
    "'per_skin' holds only what differs. Existing colours are NOT repeated here — the source of",
    "truth for them stays game/assets/skins/<id>/skin.json; this file adds the tokens the new",
    "design needs and pins the non-colour scales the design system is built on.",
    "Merge target in the implementation phase: skin.json 'tokens' (color/size/space/shape/font),",
    "'metrics' and 'motion', plus the new fields ui_metrics/layout/breakpoints below.",
    "The prototype's :root[data-theme] blocks are GENERATED from the same skins — palette drift",
    "between mock and game is impossible by construction (see tools/check_package.py)."
  ],

  "shared": {
    "size": { "xs": 10, "s": 12, "m": 13, "l": 18, "xl": 28 },
    "space": [4, 8, 12, 16, 24],
    "shape": { "radius": 0, "chamfer": 9, "chamfer_small": 6, "line": 1, "line_active": 2 },
    "font": {
      "ui": "",
      "mono": "",
      "display": "",
      "_note": "empty = the game's built-in font (has Cyrillic). The mockup uses the stacks below; a skin may ship font files instead.",
      "ui_stack": "Segoe UI, -apple-system, Roboto, Helvetica Neue, Arial, sans-serif",
      "mono_stack": "Cascadia Mono, Consolas, JetBrains Mono, ui-monospace, Menlo, monospace"
    },
    "motion": {
      "step": 0.19, "hop": 0.32, "pop": 0.5, "panel": 0.3, "card": 2.8, "dice_roll": 0.85,
      "fast": 0.12, "base": 0.19, "slow": 0.32,
      "ease": "cubic-bezier(0.2, 0, 0, 1)"
    },

    "ui_metrics": {
      "_note": "layout constants of the design system (px at the 1440×900 design size)",
      "header_h": 56, "console_h": 96, "gap": 8, "pad": 12,
      "dock_left": 268, "dock_right": 344,
      "dock_left_wide": 280, "dock_right_wide": 380,
      "dock_right_observer": 400,
      "rail": 48, "drawer": 320, "drawer_wide": 340,
      "tile_compact_below_px": 44, "tile_comfort_above_px": 56,
      "journal_min_h": 120, "inspector_min_h": 150, "inspector_max_ratio": 0.46,
      "toast_max": 3, "toast_width_max": 460,
      "row_min_h": { "chip": 18, "control": 24, "input": 28, "button": 44, "button_small": 30, "icon": 30 }
    },

    "breakpoints": [
      { "id": "wide", "min_width": 1600, "docks": [280, 380] },
      { "id": "desktop", "min_width": 1280, "min_height": 701, "docks": [268, 344] },
      { "id": "compact", "below_width": 1280, "or_max_height": 700, "docks": [48, 48], "rails": true, "drawers": true },
      { "id": "min", "width": 880, "height": 600, "note": "hard floor; below it a too-narrow notice, nothing works past it" }
    ],

    "text_roles": {
      "value": { "class": "t-value", "wrap": "never", "width": "content", "grow": false },
      "para": { "class": "t-para", "wrap": "by_words", "width": "parent", "grow": true },
      "grow_marker": "data-grow",
      "rule": "exactly one [data-grow] child per flex row; ellipsis is the last resort, not a mode"
    },

    "journal_categories": ["ty.roll", "ty.money", "ty.buy", "ty.auction", "ty.build", "ty.card", "ty.trade", "ty.other"]
  },

  "per_skin": {
    "neuro": {
      "extends": "default",
      "color_new": {
        "scrim": "#0b0613b8",
        "glow": "#ff6fae55",
        "good": "#2fa862"
      },
      "player_extra": ["#ffd166", "#8f9bff"],
      "note": "player_extra closes seats 7-8 (skins ship 6 colours today; the seat count is 2-8)."
    },
    "evil": {
      "extends": "neuro",
      "color_new": {
        "scrim": "#080406b8",
        "glow": "#e8264f55",
        "good": "#2fa862"
      },
      "player_extra": ["#ffd166", "#8f9bff"]
    },
    "default": {
      "extends": null,
      "color_new": {
        "scrim": "#16191fb8",
        "glow": "#4fb3d955",
        "good": "#3f8f5f",
        "ring_bg": "#39404d99",
        "group": {
          "brown": "#6b3a2a", "lightblue": "#7bb8d4", "pink": "#d98aa8", "orange": "#e08a3c",
          "red": "#b3403d", "yellow": "#d9c44a", "green": "#3f8f5f", "darkblue": "#2f4a7a"
        }
      },
      "player_extra": ["#46c8b8", "#d46a9e"],
      "note": "default ships no group palette and no ring_bg — both are supplied here (values from the classic set / the default line colour) so every skin is COMPLETE (P-14)."
    },
    "classic": {
      "extends": null,
      "color_new": {
        "scrim": "#16191fb8",
        "glow": "#4fb3d955",
        "good": "#3f8f5f"
      },
      "player_extra": ["#46c8b8", "#d46a9e"]
    }
  },

  "components": {
    "_note": "which tokens each design component consumes — the contract that keeps components token-pure (I-6)",
    "header": ["bg", "surface.1", "line", "text", "muted", "accent", "money", "player"],
    "dock": ["surface.1", "surface.2", "surface.3", "line", "text", "muted"],
    "seat_card": ["surface.2", "surface.3", "line", "text", "muted", "money", "player", "good", "bad"],
    "tile": ["surface.2", "surface.3", "line", "text", "muted", "money", "good", "accent", "accent2", "group", "player", "glow"],
    "dice": ["dice_bg", "dice_ink", "warn", "bad"],
    "decision_card": ["surface.1", "surface.2", "line", "text", "money", "player"],
    "banner": ["surface.1", "accent", "danger", "good", "glow"],
    "journal": ["surface.1", "line", "text", "muted", "money", "player", "ev.money", "ev.build", "ev.card"],
    "inspector": ["surface.1", "line", "text", "muted", "money", "group", "warn", "accent2"],
    "console": ["surface.1", "surface.2", "surface.3", "line", "text", "muted", "accent", "accent_ink", "good"],
    "toast": ["surface.2", "line", "text", "muted", "money", "good", "warn", "danger", "accent2"],
    "modal": ["surface.1", "line", "text", "muted", "scrim", "accent", "money", "good", "danger"],
    "timer_ring": ["ring_bg", "good", "warn", "danger", "text"],
    "overlay_sheet": ["surface.1", "surface.2", "line", "text", "muted", "accent", "accent_ink"],
    "settings_field": ["surface.2", "line", "text", "muted", "accent", "good", "warn"],
    "admin": ["surface.1", "surface.2", "line", "text", "muted", "accent", "danger", "good"]
  },

  "slots_required": [
    "tile_bg", "board_center", "button",
    "corner_icons/go_arrow", "corner_icons/jail", "corner_icons/free_parking", "corner_icons/go_to_jail",
    "type_icons/tax", "type_icons/railroad", "type_icons/utility", "type_icons/chance", "type_icons/community_chest",
    "houses/house", "houses/hotel",
    "tokens/top_hat", "tokens/cat", "tokens/ship", "tokens/race_car", "tokens/dog", "tokens/boot", "tokens/iron", "tokens/wheelbarrow",
    "dice/die_1", "dice/die_2", "dice/die_3", "dice/die_4", "dice/die_5", "dice/die_6"
  ],
  "slots_note": "All of these ship in game/assets today and are used by the prototype as-is (inlined from the game files by the build). The design adds NO new raster art: all chrome (frames, chamfers, highlights, hatching) is procedural from tokens."
}
