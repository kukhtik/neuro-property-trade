# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Generated exports
build/

# Windowed screenshot smoke artifacts
visual_smoke_*.png
visual_smoke_*.png.import
ui_*.png
ui_*.png.import

# Pinned toolchain (fetched, never committed): binary + downloaded archives
.tools/*
!.tools/godot-version

# Corpus output written into the Godot tree when the CLI is given a res:// path
game/corpus/

# Web/desktop export output
build/web/
game/tools/_args_probe.*
game/tools/_role_capture.*

# probe/debug output written next to the project
game/_*.out
game/tools/_*
game/_*
