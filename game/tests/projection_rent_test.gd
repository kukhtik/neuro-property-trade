extends RefCounted
## E-3 tests (master-fix-plan §2, D11): the rent a tile charges RIGHT NOW is visible.
##
## The defect these exist for: rent appeared in ONE place - the inspector, and even there it showed
## the CARD's value (`rent_set`), not what the game would take. A viewer looking at a dark-blue row
## with three houses read the un-improved price, and the tile's own tooltip - the one surface that
## needs no click - did not mention rent at all.
##
## The fix: the projection publishes `board[].rent_now`, computed by the ENGINE'S OWN rent function
## (engine._property_rent), so there is exactly one rent formula in the project. These tests assert
## the projection AGREES WITH THE ENGINE, which is the property that matters: a table of expected
## numbers copied into the test would pass even if both sides drifted together.

const ProjScript := preload("res://sdk/projection.gd")


static func test_list() -> Array[String]:
	return [
		"test_rent_now_is_the_base_rent_before_houses",
		"test_rent_now_rises_with_houses",
		"test_rent_now_matches_the_engine_on_a_monopoly",
		"test_rent_now_of_a_mortgaged_tile_is_zero",
		"test_rent_now_survives_the_spectator_projection",
	]


## A two-player match plus the first PROPERTY tile the board declares. The index is discovered,
## never hard-coded: board.json is generated by tools/gen_boards.py, so an index written into a test
## is a number that silently comes to mean a different cell the next time the board is regenerated.
static func _match() -> Dictionary:
	var E = load("res://core/engine.gd")
	var S = load("res://core/game_settings.gd")
	var e = E.new()
	e.setup(S.new(), ["Ada", "Bo"])
	# find a real property tile on the board (the test must not hard-code an index that the
	# generator could move - board.json is generated by tools/gen_boards.py)
	var tile := -1
	for i in e.board.tile_count():
		var t = e.board.tile_at(i)
		if str(t.get("type", "")) == "property":
			tile = i
			break
	return {"engine": e, "tile": tile}


static func _proj_board(engine) -> Dictionary:
	var p = ProjScript.new()
	var view: Array = p.for_spectator(engine).get("board", [])
	var out := {}
	for t in view:
		out[int(t.get("index", -1))] = t
	return out


## --- the numbers ------------------------------------------------------------------------------

static func test_rent_now_is_the_base_rent_before_houses() -> String:
	var m := _match()
	var e = m["engine"]
	var tile: int = m["tile"]
	if tile < 0:
		return "the board has no property tile - the test would be vacuous"
	# give it to player 0 without building: rent_now must equal the engine's own answer
	e.players[0].add_ownership(tile)
	var board := _proj_board(e)
	var entry: Dictionary = board[tile]
	if not entry.has("rent_now"):
		return "the projection does not publish rent_now at all"
	var want: int = int(e._property_rent(tile, 0))
	if int(entry["rent_now"]) != want:
		return "rent_now=%d but the engine charges %d" % [int(entry["rent_now"]), want]
	return ""


static func test_rent_now_rises_with_houses() -> String:
	var m := _match()
	var e = m["engine"]
	var tile: int = m["tile"]
	e.players[0].add_ownership(tile)
	var base: int = int(_proj_board(e)[tile]["rent_now"])
	# put houses on it and expect the number to follow the engine, not a table
	e._houses[tile] = 3
	var three: int = int(_proj_board(e)[tile]["rent_now"])
	if three <= base:
		return "rent_now must rise with 3 houses: base=%d with_houses=%d" % [base, three]
	if three != base * 3 and three < base * 3:
		# the board data doubles/triples rent per house; just require it to be the ENGINE's number
		return "rent_now=%d does not match the engine's %d" % [three, int(e._property_rent(tile, 0))]
	# and the projection must track the engine exactly at every step
	for h in [1, 2, 4, 5]:
		e._houses[tile] = h
		var got: int = int(_proj_board(e)[tile]["rent_now"])
		var want: int = int(e._property_rent(tile, 0))
		if got != want:
			return "with %d houses rent_now=%d but the engine charges %d" % [h, got, want]
	return ""


static func test_rent_now_matches_the_engine_on_a_monopoly() -> String:
	# The doubling rule is the one a player most often gets wrong by hand, so pin the projection to
	# the engine rather than to a number this test author believed.
	var m := _match()
	var e = m["engine"]
	var tile: int = m["tile"]
	var group: String = str(e.board.tile_at(tile).get("group", ""))
	if group == "":
		return "precondition: the chosen tile must belong to a group"
	# buy the WHOLE group for player 0 (monopoly) but build nothing
	for t in e.board.group_tiles(group):
		e.players[0].add_ownership(int(t))
	var board := _proj_board(e)
	var got: int = int(board[tile]["rent_now"])
	var want: int = int(e._property_rent(tile, 0))
	if got != want:
		return "on a monopoly rent_now=%d but the engine charges %d" % [got, want]
	# and the monopoly must actually be worth MORE than the bare rent (otherwise this proves nothing)
	var bare: int = int(e.board.tile_at(tile).get("rent", 0))
	if got < bare:
		return "a monopoly rent (%d) below the bare rent (%d) - the projection is not doubling" % [got, bare]
	return ""


static func test_rent_now_of_a_mortgaged_tile_is_zero() -> String:
	# A mortgaged property collects nothing. If the tooltip showed a positive rent here, a viewer
	# would be told a rival owes money they do not.
	var m := _match()
	var e = m["engine"]
	var tile: int = m["tile"]
	e.players[0].add_ownership(tile)
	e._mortgaged.append(tile)
	var got: int = int(_proj_board(e)[tile]["rent_now"])
	if got != 0:
		return "a mortgaged tile must show rent 0, got %d" % got
	return ""


static func test_rent_now_survives_the_spectator_projection() -> String:
	# A spectator is the stream's whole audience: the number must be in THEIR projection too, not
	# only in the player's (the two are built by different functions and can drift).
	var m := _match()
	var e = m["engine"]
	var tile: int = m["tile"]
	e.players[0].add_ownership(tile)
	e._houses[tile] = 2
	var p = ProjScript.new()
	var spec: Array = p.for_spectator(e).get("board", [])
	var found := false
	for t in spec:
		if int(t.get("index", -1)) != tile:
			continue
		found = true
		if not t.has("rent_now"):
			return "the spectator projection lost rent_now"
		if int(t["rent_now"]) != int(e._property_rent(tile, 0)):
			return "spectator rent_now=%d but the engine charges %d" % [int(t["rent_now"]), int(e._property_rent(tile, 0))]
	if not found:
		return "tile %d is missing from the spectator board" % tile
	return ""
